{
  "caseSensitive": false,
  "dictionaries": ["custom-words"],
  "dictionaryDefinitions": [
    {
      "name": "custom-words",
      "path": "./.cspell/custom-words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/package.json",
    "eslint.config.mjs",
    "commitlint.config.mjs",
    "postcss.config.mjs",
    "tailwind.config.mjs",
    "tsconfig.json"
  ],
  "import": ["@cspell/dict-lorem-ipsum/cspell-ext.json"]
}
